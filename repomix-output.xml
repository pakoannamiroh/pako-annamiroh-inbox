<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pako An Namiroh — Inbox</title>
<style>
  :root{
    --text:#2C2C2B;--text-2:#7D7A75;--canvas:#FFFFFF;--soft:#F9F8F7;--soft-2:#F0EFED;
    --border:#E6E5E3;--blue:#2783DE;--blue-soft:#E5F2FC;--green:#46A171;--green-soft:#E8F1EC;
    --orange:#D5803B;--orange-soft:#FBEBDE;--red:#E56458;--red-soft:#FCE9E7;--wa:#075E54;--wa-bubble:#DCF8C6;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--text);background:var(--soft-2);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
  .app{max-width:1180px;margin:0 auto;background:var(--canvas);height:100vh;display:flex;flex-direction:column;border-left:1px solid var(--border);border-right:1px solid var(--border)}
  .topbar{height:60px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid var(--border);flex-shrink:0}
  .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}
  .brand .logo{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#128C7E,#075E54);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px}
  .brand small{display:block;font-weight:500;color:var(--text-2);font-size:12px}
  .topbar .spacer{flex:1}
  .wa-status{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-2);padding:6px 12px;border:1px solid var(--border);border-radius:8px}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--green)}
  .dot.off{background:var(--orange)}
  .avatar-me{width:34px;height:34px;border-radius:50%;background:var(--blue-soft);color:var(--blue);display:flex;align-items:center;justify-content:center;font-weight:700}
  .layout{display:grid;grid-template-columns:320px 1fr 300px;flex:1;min-height:0}
  .col{display:flex;flex-direction:column;min-height:0}
  .col-list{border-right:1px solid var(--border)}
  .col-lead{border-left:1px solid var(--border);background:var(--soft)}
  .search{padding:12px 16px;border-bottom:1px solid var(--border)}
  .search input{width:100%;padding:9px 12px 9px 34px;border:1px solid var(--border);border-radius:8px;font-size:14px;color:var(--text);background:var(--soft) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none' stroke='%237D7A75' stroke-width='2' viewBox='0 0 24 24'><circle cx='11' cy='11' r='7'/><path d='m21 21-4.3-4.3'/></svg>") 10px center no-repeat}
  .filters{display:flex;gap:6px;padding:10px 16px;border-bottom:1px solid var(--border);flex-wrap:wrap}
  .chip{font-size:12.5px;padding:5px 11px;border-radius:999px;border:1px solid var(--border);background:var(--canvas);color:var(--text-2);cursor:pointer;font-weight:500}
  .chip.active{background:var(--text);color:#fff;border-color:var(--text)}
  .chip.cold.active{background:var(--blue);border-color:var(--blue)}
  .chip.warm.active{background:var(--orange);border-color:var(--orange)}
  .chip.hot.active{background:var(--red);border-color:var(--red)}
  .chatlist{overflow-y:auto;flex:1}
  .chat-item{display:flex;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid var(--soft-2);position:relative}
  .chat-item:hover{background:var(--soft)}
  .chat-item.active{background:var(--blue-soft)}
  .chat-item.active::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--blue)}
  .ci-avatar{width:44px;height:44px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:16px}
  .ci-main{flex:1;min-width:0}
  .ci-top{display:flex;justify-content:space-between;align-items:baseline;gap:6px}
  .ci-name{font-weight:600;font-size:14.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ci-time{font-size:11.5px;color:var(--text-2);flex-shrink:0}
  .ci-msg{font-size:13px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
  .ci-badges{display:flex;gap:5px;margin-top:6px;align-items:center}
  .badge{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px}
  .b-cold{background:var(--blue-soft);color:var(--blue)}
  .b-warm{background:var(--orange-soft);color:var(--orange)}
  .b-hot{background:var(--red-soft);color:var(--red)}
  .b-none{background:var(--soft-2);color:var(--text-2)}
  .b-ai{background:var(--green-soft);color:var(--green)}
  .b-ai.off{background:var(--soft-2);color:var(--text-2)}
  .unread{margin-left:auto;background:var(--green);color:#fff;font-size:11px;font-weight:700;min-width:19px;height:19px;border-radius:999px;display:flex;align-items:center;justify-content:center;padding:0 5px}
  .conv-head{height:64px;display:flex;align-items:center;gap:12px;padding:0 18px;border-bottom:1px solid var(--border);background:var(--canvas);flex-shrink:0}
  .conv-head .ci-avatar{width:40px;height:40px;font-size:15px}
  .conv-title{font-weight:600}
  .conv-sub{font-size:12.5px;color:var(--text-2)}
  .ai-toggle{margin-left:auto;display:flex;align-items:center;gap:10px}
  .toggle-label{font-size:12.5px;font-weight:600}
  .toggle-label span{color:var(--green)}
  .switch{width:42px;height:24px;border-radius:999px;background:var(--green);position:relative;cursor:pointer;transition:background .2s}
  .switch::after{content:"";position:absolute;top:2px;left:20px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.2);transition:left .2s}
  .switch.off{background:var(--soft-2)}
  .switch.off::after{left:2px}
  .messages{flex:1;overflow-y:auto;padding:20px 24px;background:#ECE5DD;background-image:radial-gradient(rgba(255,255,255,0.45) 1px,transparent 1px);background-size:22px 22px;display:flex;flex-direction:column;gap:10px}
  .day-sep{align-self:center;background:rgba(255,255,255,0.85);color:var(--text-2);font-size:11.5px;padding:3px 12px;border-radius:999px;margin:4px 0}
  .bubble{max-width:74%;padding:8px 12px;border-radius:10px;font-size:14px;box-shadow:0 1px 1px rgba(0,0,0,.08);position:relative;word-wrap:break-word;white-space:pre-wrap}
  .bubble .t{display:block;font-size:10.5px;color:var(--text-2);text-align:right;margin-top:3px}
  .in{align-self:flex-start;background:#fff;border-top-left-radius:3px}
  .out{align-self:flex-end;background:var(--wa-bubble);border-top-right-radius:3px}
  .empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--text-2);gap:12px;text-align:center;padding:40px;background:#ECE5DD}
  .composer{display:flex;gap:10px;align-items:center;padding:12px 16px;border-top:1px solid var(--border);background:var(--canvas);flex-shrink:0}
  .composer input{flex:1;padding:11px 14px;border:1px solid var(--border);border-radius:10px;font-size:14px}
  .send{width:42px;height:42px;border-radius:10px;background:var(--wa);color:#fff;border:none;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center}
  .lead{overflow-y:auto;flex:1;padding:18px 16px;display:flex;flex-direction:column;gap:16px}
  .card{background:var(--canvas);border:1px solid var(--border);border-radius:12px;padding:14px}
  .card h3{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-2);margin-bottom:10px;font-weight:700;display:flex;align-items:center;gap:6px;justify-content:space-between}
  .soon{font-size:9.5px;font-weight:700;letter-spacing:.02em;color:var(--orange);background:var(--orange-soft);padding:2px 7px;border-radius:999px;text-transform:none}
  .score-wrap{display:flex;align-items:center;gap:14px}
  .ring{width:76px;height:76px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center}
  .ring .inner{width:58px;height:58px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .ring .num{font-size:20px;font-weight:800;line-height:1}
  .ring .cap{font-size:9.5px;color:var(--text-2)}
  .score-side .lvl{font-size:16px;font-weight:800;display:flex;align-items:center;gap:6px}
  .score-side .desc{font-size:12px;color:var(--text-2);margin-top:2px}
  .signals{list-style:none;display:flex;flex-direction:column;gap:7px}
  .signals li{font-size:13px;display:flex;gap:8px;align-items:flex-start}
  .signals .ic{color:var(--green);font-weight:700}
  .muted{font-size:12.5px;color:var(--text-2)}
  .info-row{display:flex;justify-content:space-between;gap:10px;font-size:13px;padding:6px 0;border-bottom:1px dashed var(--soft-2)}
  .info-row:last-child{border-bottom:none}
  .info-row .k{color:var(--text-2)}
  .info-row .v{font-weight:600;text-align:right;word-break:break-word}
  .fbc-ok{color:var(--green);font-weight:700}
  .fbc-no{color:var(--text-2);font-weight:700}
  .signal-btns{display:flex;flex-direction:column;gap:8px}
  .sig{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:10px;cursor:pointer;border:1px solid transparent;font-weight:600;font-size:14px;opacity:1}
  .sig:hover{filter:brightness(0.92)}
  .sig.loading{cursor:wait;opacity:.6;pointer-events:none}
  .sig .ico{font-size:17px}
  .sig-warm{background:var(--orange-soft);color:var(--orange);border-color:#F0CDA8}
  .sig-hot{background:var(--red-soft);color:var(--red);border-color:#F3BEB8}
  .sig-pay{background:var(--green);color:#fff}
  .sig .arrow{margin-left:auto;opacity:.6}
  .log{list-style:none;display:flex;flex-direction:column;gap:9px}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--text);color:#fff;font-size:13px;padding:10px 16px;border-radius:10px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:50}
  .toast.show{opacity:.95}
  .hide{display:none!important}
</style>
</head>
<body>
<div class="app">
  <div class="topbar">
    <div class="brand">
      <div class="logo">☪</div>
      <div>Pako An Namiroh <small>WhatsApp Inbox + Panel Ads</small></div>
    </div>
    <div class="spacer"></div>
    <div class="wa-status" id="wa-status"><span class="dot" id="wa-dot"></span> <span id="wa-text">Menghubungkan…</span></div>
    <div class="avatar-me">P</div>
  </div>

  <div class="layout">
    <!-- COL 1: chat list -->
    <div class="col col-list">
      <div class="search"><input id="q" placeholder="Cari kontak / nomor…" /></div>
      <div class="filters" id="filters">
        <div class="chip active" data-f="all">Semua</div>
        <div class="chip cold" data-f="cold">🧊 Cold</div>
        <div class="chip warm" data-f="warm">🌤️ Warm</div>
        <div class="chip hot" data-f="hot">🔥 Hot</div>
      </div>
      <div class="chatlist" id="list"></div>
    </div>

    <!-- COL 2: conversation -->
    <div class="col">
      <div id="conv-empty" class="empty">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <div>Pilih percakapan untuk mulai membalas</div>
      </div>
      <div id="conv-view" class="hide" style="display:flex;flex-direction:column;flex:1;min-height:0">
        <div class="conv-head">
          <div class="ci-avatar" id="c-avatar">?</div>
          <div>
            <div class="conv-title" id="c-name">—</div>
            <div class="conv-sub" id="c-sub">—</div>
          </div>
          <div class="ai-toggle" title="Klik untuk aktif/nonaktifkan balasan AI di chat ini">
            <div class="toggle-label">Mode <span id="ai-mode">CS Manual</span></div>
            <div class="switch off" id="ai-switch"></div>
          </div>
        </div>
        <div class="messages" id="msgs"></div>
        <div class="composer">
          <input id="reply-input" placeholder="Ketik balasan…" />
          <button class="send" id="send-btn" title="Kirim">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- COL 3: lead panel -->
    <div class="col col-lead">
      <div id="lead-empty" class="lead"><div class="muted">Info lead akan muncul di sini setelah kamu memilih percakapan.</div></div>
      <div id="lead-view" class="lead hide">
        <div class="card">
          <h3>Lead Score <span class="soon">Fase 2</span></h3>
          <div class="score-wrap">
            <div class="ring" id="score-ring"><div class="inner"><span class="num" id="score-num">–</span><span class="cap">/100</span></div></div>
            <div class="score-side">
              <div class="lvl" id="score-lvl">Belum dinilai</div>
              <div class="desc" id="score-desc">Penilaian otomatis oleh AI aktif di Fase 2.</div>
            </div>
          </div>
          <ul class="signals" id="signals" style="margin-top:12px"></ul>
        </div>

        <div class="card">
          <h3>Kirim Sinyal ke Meta <span class="soon">Fase 1</span></h3>
          <div class="signal-btns">
            <div class="sig sig-warm" onclick="sendSignal('warm')"><span class="ico">🌤️</span> Tandai Warm — tertarik <span class="arrow">›</span></div>
            <div class="sig sig-hot" onclick="sendSignal('hot')"><span class="ico">🔥</span> Tandai Hot — mau beli <span class="arrow">›</span></div>
            <div class="sig sig-pay" onclick="openPurchaseModal()"><span class="ico">💰</span> Konfirmasi Bayar (DP) <span class="arrow">›</span></div>
          </div>
        </div>

        <div class="card">
          <h3>Info Lead</h3>
          <div class="info-row"><span class="k">Nama</span><span class="v" id="i-name">—</span></div>
          <div class="info-row"><span class="k">No. WA</span><span class="v" id="i-hp">—</span></div>
          <div class="info-row"><span class="k">Sumber</span><span class="v" id="i-src">—</span></div>
          <div class="info-row"><span class="k">Kode unik</span><span class="v" id="i-kode">—</span></div>
          <div class="info-row"><span class="k">Status fbc</span><span class="v" id="i-fbc">—</span></div>
          <div class="info-row"><span class="k">Chat pertama</span><span class="v" id="i-first">—</span></div>
        </div>

        <div class="card">
          <h3>Log Sinyal CAPI <span class="soon">Fase 1</span></h3>
          <ul class="log" id="log-box"><li class="muted">Belum ada sinyal terkirim. Riwayat event (Lead / Purchase) akan tampil di sini mulai Fase 1.</li></ul>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="modal-pay" style="display:none;position:fixed;inset:0;z-index:100;background:rgba(30,28,26,0.45);align-items:center;justify-content:center">
  <div style="width:380px;background:#fff;border-radius:16px;padding:24px;box-shadow:0 12px 40px rgba(0,0,0,.2)">
    <h2 style="font-size:18px;font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:4px">💰 Konfirmasi Pembayaran</h2>
    <p style="font-size:13px;color:var(--text-2);margin-bottom:18px">Kirim event <b>Purchase</b> ke Meta untuk <span id="modal-nama">—</span>.</p>

    <div style="margin-bottom:14px">
      <label style="font-size:12px;font-weight:600;color:var(--text-2);display:block;margin-bottom:6px">Nilai order (Rp) — boleh dikosongkan</label>
      <div style="display:flex;align-items:center;border:1px solid var(--border);border-radius:8px;overflow:hidden">
        <span style="padding:10px 12px;background:var(--soft);color:var(--text-2);font-size:14px;font-weight:600;border-right:1px solid var(--border)">Rp</span>
        <input id="modal-nilai" type="number" min="0" placeholder="Contoh: 28500000"
          style="flex:1;padding:10px 12px;border:none;font-size:14px;outline:none" />
      </div>
      <div style="font-size:11.5px;color:var(--text-2);margin-top:4px">Kosongkan bila hanya ingin kirim event tanpa nilai.</div>
    </div>

    <div style="margin-bottom:14px">
      <label style="font-size:12px;font-weight:600;color:var(--text-2);display:block;margin-bottom:6px">Status pembayaran</label>
      <div style="display:flex;gap:8px" id="modal-status-row">
        <div id="modal-dp" onclick="selectStatus('dp')"
          style="flex:1;padding:9px;text-align:center;border-radius:8px;border:2px solid var(--green);background:var(--green-soft);color:var(--green);font-weight:700;cursor:pointer;font-size:13.5px">DP</div>
        <div id="modal-lunas" onclick="selectStatus('lunas')"
          style="flex:1;padding:9px;text-align:center;border-radius:8px;border:2px solid var(--border);color:var(--text-2);font-weight:600;cursor:pointer;font-size:13.5px">Lunas</div>
      </div>
    </div>

    <div style="margin-bottom:20px">
      <label style="font-size:12px;font-weight:600;color:var(--text-2);display:block;margin-bottom:6px">Catatan (opsional)</label>
      <textarea id="modal-catatan" rows="2" placeholder="Mis. DP via BSI, transfer 19:50"
        style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:8px;font-size:13px;font-family:inherit;resize:none;outline:none"></textarea>
    </div>

    <div style="display:flex;gap:10px">
      <button onclick="closePayModal()"
        style="flex:1;padding:11px;border:1px solid var(--border);border-radius:8px;background:var(--canvas);font-size:14px;font-weight:600;cursor:pointer">Batal</button>
      <button id="modal-submit" onclick="submitPurchase()"
        style="flex:2;padding:11px;border:none;border-radius:8px;background:var(--green);color:#fff;font-size:14px;font-weight:700;cursor:pointer">Kirim Purchase ke Meta →</button>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script>
const SAMPLE={
  chats:[
    {id:1,nama:"Budi Santoso",no_hp:"6285163635464",status_lead:"hot",skor_lead:82,ai_aktif:false,sumber_iklan:"IG Ads · Umroh Ramadhan",fbc:"fb.1.1782999698159.ABC123",kode:"A7K9",last:"Kalau DP dulu bisa ya kak? Kirim no rekeningnya…",last_time:"19:42",first:"2 Jul, 18:10",unread:0,
      signals:["Menanyakan cara bayar / DP","Menyebut waktu berangkat (September)","Tanya paket spesifik (9 hari)","Responsif (balas 5x)"]},
    {id:2,nama:"Siti Wardah",no_hp:"6281234227638",status_lead:"warm",skor_lead:58,ai_aktif:true,sumber_iklan:"IG Ads · Umroh Ramadhan",fbc:"fb.1.1782991112000.XY88",kode:"K3P2",last:"Rencana berangkat bulan 9, paket yang Madinah dulu…",last_time:"19:20",first:"2 Jul, 17:55",unread:2},
    {id:3,nama:"Ahmad Hidayat",no_hp:"6281290388261",status_lead:"warm",skor_lead:49,ai_aktif:true,sumber_iklan:"FB · Promo DP",fbc:"fb.1.1782980001231.QW51",kode:"M9T4",last:"Oke kak, nanti saya diskusikan sama…",last_time:"18:55",first:"2 Jul, 18:40",unread:0},
    {id:4,nama:"Rina (IG Ads)",no_hp:"6281343361382",status_lead:"cold",skor_lead:22,ai_aktif:true,sumber_iklan:"IG Ads · Umroh Hemat",fbc:"fb.1.1782970000000.LM10",kode:"P2R8",last:"Harga paket umroh yang paling mura…",last_time:"18:30",first:"2 Jul, 18:30",unread:0},
    {id:5,nama:"M. Fauzan",no_hp:"6281244938826",status_lead:"cold",skor_lead:15,ai_aktif:true,sumber_iklan:"organic",fbc:null,kode:null,last:"Terima kasih infonya kak 🙏",last_time:"Kmrn",first:"1 Jul, 20:10",unread:0}
  ],
  messages:{
    1:[
      {arah:"masuk",pesan:"Assalamualaikum, saya mau tanya paket umroh (Kode: A7K9)",t:"19:05"},
      {arah:"keluar",pesan:"Waalaikumsalam kak Budi 🙏 Untuk keberangkatan yang kakak rencanakan kapan ya? Kami ada paket 9 & 12 hari.",t:"19:06"},
      {arah:"masuk",pesan:"Rencana September ini. Yang 9 hari berapaan?",t:"19:31"},
      {arah:"keluar",pesan:"Paket 9 hari mulai Rp 28,5 juta sudah termasuk hotel dekat Masjidil Haram kak 🕋",t:"19:32"},
      {arah:"masuk",pesan:"Kalau DP dulu bisa ya kak? Kirim no rekeningnya dong",t:"19:42"}
    ]
  }
};

let state={chats:[],active:null,filter:"all",q:"",demo:false};
const $=s=>document.querySelector(s);
const esc=s=>(s||"").replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
const initials=n=>(n||"?").trim().split(/\s+/).slice(0,2).map(w=>w[0]||"").join("").toUpperCase()||"?";
const LEADCOLOR={hot:"#E56458",warm:"#D5803B",cold:"#2783DE"};
const leadLabel=l=>({cold:"🧊 Cold",warm:"🌤️ Warm",hot:"🔥 Hot"}[l]||"Belum dinilai");
function toast(t){const el=$("#toast");el.textContent=t;el.classList.add("show");clearTimeout(el._t);el._t=setTimeout(()=>el.classList.remove("show"),2200)}

async function api(path,opts){const r=await fetch(path,opts);if(!r.ok)throw new Error("HTTP "+r.status);return r.json()}

function setStatus(){
  const dot=$("#wa-dot"),txt=$("#wa-text");
  if(state.demo){dot.classList.add("off");txt.textContent="Mode demo (data contoh)"}
  else{dot.classList.remove("off");txt.textContent="Backend terhubung"}
}

async function loadChats(){
  try{state.chats=await api("/api/chats");state.demo=false}
  catch(e){state.demo=true;state.chats=SAMPLE.chats}
  setStatus();renderList();
}

function renderList(){
  const list=$("#list");list.innerHTML="";
  const q=state.q.toLowerCase();
  const rows=state.chats.filter(c=>{
    if(state.filter!=="all"&&(c.status_lead||"")!==state.filter)return false;
    if(q&&!((c.nama||"").toLowerCase().includes(q)||(c.no_hp||"").includes(q)))return false;
    return true;
  });
  if(!rows.length){list.innerHTML='<div style="padding:24px;text-align:center" class="muted">Tidak ada kontak</div>';return}
  for(const c of rows){
    const lead=c.status_lead||"none";
    const el=document.createElement("div");
    el.className="chat-item"+(state.active===c.id?" active":"");
    el.onclick=()=>openChat(c.id);
    const aiBadge=c.ai_aktif===false?'<span class="badge b-ai off">CS Manual</span>':'<span class="badge b-ai">AI Aktif</span>';
    const unread=c.unread>0?`<span class="unread">${c.unread}</span>`:"";
    el.innerHTML=`
      <div class="ci-avatar" style="background:${LEADCOLOR[c.status_lead]||"#B5B2AD"}">${esc(initials(c.nama))}</div>
      <div class="ci-main">
        <div class="ci-top"><span class="ci-name">${esc(c.nama||c.no_hp)}</span><span class="ci-time">${esc(c.last_time||"")}</span></div>
        <div class="ci-msg">${esc(c.last||"")}</div>
        <div class="ci-badges"><span class="badge b-${lead}">${leadLabel(c.status_lead)}</span>${aiBadge}${unread}</div>
      </div>`;
    list.appendChild(el);
  }
}

function applyAIToggleUI(c){
  const sw=$("#ai-switch");
  if(c.ai_aktif===false){
    sw.classList.add("off");
    $("#ai-mode").textContent="Mode CS Manual";
    $("#ai-mode").style.color="var(--text-2)";
  }else{
    sw.classList.remove("off");
    $("#ai-mode").textContent="AI Aktif";
    $("#ai-mode").style.color="";
  }
}

async function openChat(id){
  state.active=id;renderList();
  const c=state.chats.find(x=>x.id===id);if(!c)return;
  $("#conv-empty").classList.add("hide");$("#conv-view").classList.remove("hide");
  $("#lead-empty").classList.add("hide");$("#lead-view").classList.remove("hide");
  const col=LEADCOLOR[c.status_lead]||"#B5B2AD";
  $("#c-avatar").textContent=initials(c.nama);$("#c-avatar").style.background=col;
  $("#c-name").textContent=c.nama||c.no_hp;
  $("#c-sub").textContent="+"+(c.no_hp||"")+(c.sumber_iklan?" · "+c.sumber_iklan:"");
  applyAIToggleUI(c);
  // Lead score
  const num=$("#score-num"),ring=$("#score-ring"),lvl=$("#score-lvl");
  if(typeof c.skor_lead==="number"){
    num.textContent=c.skor_lead;
    ring.style.background=`conic-gradient(${col} 0 ${c.skor_lead}%, var(--soft-2) ${c.skor_lead}% 100%)`;
    lvl.textContent=leadLabel(c.status_lead);lvl.style.color=col;
    $("#score-desc").textContent=state.demo?"Contoh skor (analisis AI aktif di Fase 2).":"Analisis AI aktif di Fase 2.";
  }else{
    num.textContent="–";ring.style.background="conic-gradient(var(--soft-2) 0 100%)";
    lvl.textContent="Belum dinilai";lvl.style.color="var(--text-2)";
    $("#score-desc").textContent="Penilaian otomatis oleh AI aktif di Fase 2.";
  }
  const sig=$("#signals");sig.innerHTML="";
  (c.signals||[]).forEach(s=>{const li=document.createElement("li");li.innerHTML=`<span class="ic">✓</span> ${esc(s)}`;sig.appendChild(li)});
  // Info lead
  $("#i-name").textContent=c.nama||"—";
  $("#i-hp").textContent="+"+(c.no_hp||"—");
  $("#i-src").textContent=c.sumber_iklan||"—";
  $("#i-kode").textContent=c.kode||"—";
  $("#i-fbc").innerHTML=c.fbc?'<span class="fbc-ok">● Terhubung</span>':'<span class="fbc-no">○ Tidak ada</span>';
  $("#i-first").textContent=c.first||"—";
  await loadMessages(id);
  await loadSignals(id);
}

async function loadMessages(id){
  let msgs=[];
  if(state.demo)msgs=SAMPLE.messages[id]||[];
  else{try{msgs=await api("/api/chats/"+id+"/messages")}catch(e){msgs=[]}}
  const box=$("#msgs");box.innerHTML='<div class="day-sep">Hari ini</div>';
  for(const m of msgs){
    const el=document.createElement("div");
    el.className="bubble "+(m.arah==="keluar"?"out":"in");
    el.innerHTML=esc(m.pesan)+`<span class="t">${esc(m.t||"")}</span>`;
    box.appendChild(el);
  }
  box.scrollTop=box.scrollHeight;
}

async function send(){
  const ta=$("#reply-input"),text=ta.value.trim();if(!text||!state.active)return;
  ta.value="";
  if(state.demo){
    const box=$("#msgs"),el=document.createElement("div");
    el.className="bubble out";el.innerHTML=esc(text)+'<span class="t">baru saja</span>';
    box.appendChild(el);box.scrollTop=box.scrollHeight;return;
  }
  try{await api("/api/chats/"+state.active+"/send",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({text})});await loadMessages(state.active)}
  catch(e){toast("Gagal mengirim: "+e.message)}
}

async function sendSignal(kualitas) {
  if (!state.active) return;
  const btn = document.querySelector(`.sig-${kualitas}`);
  if (btn) btn.classList.add('loading');
  try {
    const r = await api('/api/signal', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kontak_id: state.active, kualitas })
    });
    // Update status lead di daftar chat lokal
    const chat = state.chats.find(c => c.id === state.active);
    if (chat) { chat.status_lead = kualitas; renderList(); }
    // Update badge di header percakapan
    const col = LEADCOLOR[kualitas] || '#B5B2AD';
    $('#c-avatar').style.background = col;
    toast(kualitas === 'warm' ? '🌤️ Sinyal Warm terkirim ke Meta!' : '🔥 Sinyal Hot terkirim ke Meta!');
    await loadSignals(state.active);
  } catch(e) {
    toast('Gagal kirim sinyal: ' + e.message);
  } finally {
    if (btn) btn.classList.remove('loading');
  }
}

let modalStatus = 'dp';

function selectStatus(s) {
  modalStatus = s;
  const dp = document.getElementById('modal-dp');
  const lunas = document.getElementById('modal-lunas');
  if (s === 'dp') {
    dp.style.borderColor = 'var(--green)'; dp.style.background = 'var(--green-soft)'; dp.style.color = 'var(--green)';
    lunas.style.borderColor = 'var(--border)'; lunas.style.background = ''; lunas.style.color = 'var(--text-2)';
  } else {
    lunas.style.borderColor = 'var(--blue)'; lunas.style.background = 'var(--blue-soft)'; lunas.style.color = 'var(--blue)';
    dp.style.borderColor = 'var(--border)'; dp.style.background = ''; dp.style.color = 'var(--text-2)';
  }
}

function openPurchaseModal() {
  if (!state.active) return;
  const chat = state.chats.find(c => c.id === state.active);
  document.getElementById('modal-nama').textContent = chat ? (chat.nama || chat.no_hp) : '—';
  document.getElementById('modal-nilai').value = '';
  document.getElementById('modal-catatan').value = '';
  selectStatus('dp');
  const modal = document.getElementById('modal-pay');
  modal.style.display = 'flex';
}

function closePayModal() {
  document.getElementById('modal-pay').style.display = 'none';
}

async function submitPurchase() {
  const nilai = document.getElementById('modal-nilai').value;
  const catatan = document.getElementById('modal-catatan').value;
  const btn = document.getElementById('modal-submit');
  btn.textContent = 'Mengirim…'; btn.disabled = true;
  try {
    await api('/api/purchase', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        kontak_id: state.active,
        nilai_order: nilai ? Number(nilai) : null,
        status: modalStatus,
        catatan: catatan || null
      })
    });
    const nilaiText = nilai ? ' (Rp ' + Number(nilai).toLocaleString('id-ID') + ')' : '';
    closePayModal();
    toast('💰 Purchase terkirim ke Meta!' + nilaiText);
    await loadSignals(state.active);
  } catch(e) {
    toast('Gagal kirim Purchase: ' + e.message);
  } finally {
    btn.textContent = 'Kirim Purchase ke Meta →'; btn.disabled = false;
  }
}

// Tutup modal kalau klik di luar kotak
document.getElementById('modal-pay').addEventListener('click', function(e) {
  if (e.target === this) closePayModal();
});

async function loadSignals(kontakId) {
  const box = $('#log-box');
  if (!box) return;
  if (state.demo) {
    box.innerHTML = '<li style="color:var(--text-2);font-size:12px">Mode demo — log tidak tersedia</li>';
    return;
  }
  try {
    const logs = await api('/api/signals/' + kontakId);
    if (!logs.length) {
      box.innerHTML = '<li style="color:var(--text-2);font-size:12px">Belum ada sinyal terkirim.</li>';
      return;
    }
    box.innerHTML = logs.map(l => {
      const icon = l.jenis === 'Purchase' ? '💰' : l.kualitas === 'hot' ? '🔥' : '🌤️';
      const label = l.jenis === 'Purchase'
        ? `Purchase${l.nilai_order ? ' Rp ' + Number(l.nilai_order).toLocaleString('id-ID') : ''}`
        : `Lead ${l.kualitas}`;
      const statusColor = l.status === 'terkirim' ? 'var(--green)' : 'var(--red)';
      return `<li style="font-size:12.5px;display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-bottom:1px dashed var(--soft-2)">
        <span>${icon}</span>
        <span style="flex:1">
          <strong>${label}</strong>
          <span style="color:${statusColor};margin-left:6px">${l.status === 'terkirim' ? '✓ Terkirim' : '✗ Gagal'}</span>
          <br><span style="color:var(--text-2);font-size:11px">${l.waktu}</span>
          ${l.pesan_error ? `<br><span style="color:var(--red);font-size:11px">${l.pesan_error}</span>` : ''}
        </span>
      </li>`;
    }).join('');
  } catch(e) {
    box.innerHTML = '<li style="color:var(--red);font-size:12px">Gagal load log.</li>';
  }
}

async function toggleAI(){
  if(!state.active) return;
  const c=state.chats.find(x=>x.id===state.active);
  if(!c) return;
  const next=(c.ai_aktif===false);
  if(state.demo){c.ai_aktif=next;applyAIToggleUI(c);renderList();return;}
  const sw=document.querySelector("#ai-switch");
  sw.style.pointerEvents="none";
  try{
    await api("/api/chats/"+c.id+"/ai", {method:"PATCH",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({ai_aktif:next})});
    c.ai_aktif=next;
    applyAIToggleUI(c);
    renderList();
    toast(next ? "🤖 AI diaktifkan untuk chat ini"
               : "🙋 Mode CS Manual — AI berhenti balas otomatis");
  }catch(e){toast("Gagal ubah mode AI: "+e.message);}
  finally{sw.style.pointerEvents="";}
}

