  } catch(e) {
    toast('Gagal kirim sinyal: ' + e.message);
  } finally {
    if (btn) btn.classList.remove('loading');
  }
}

function openPurchaseModal() {
  if (!state.active) return;
  const val = prompt('Nilai order (RP)? Kosongkan kalau tidak ingin kirim nilai.\nContoh: 28500000');
  if (val === null) return; // user klik Cancel
  sendPurchase(val);
}

async function sendPurchase(nilai_order) {
  const btn = document.querySelector('.sig-pay');
  if (btn) btn.classList.add('loading');
  try {
    await api('/api/purchase', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kontak_id: state.active, nilai_order: nilai_order || null })
    });
    const nilaiText = nilai_order ? ' (Rp ' + Number(nilai_order).toLocaleString('id-ID') + ')' : '';
    toast('💰 Purchase terkirim ke Meta!' + nilaiText);
    await loadSignals(state.active);
  } catch(e) {
    toast('Gagal kirim Purchase: ' + e.message);
  } finally {
    if (btn) btn.classList.remove('loading');
  }
}

async function loadSignals(kontakId) {
  const box = $('#log-box');
  if (!box) return;
  if (state.demo) {
    box.innerHTML = '<li style="color:var(--text-2);font-size:12px">Mode demo — log tidak tersedia</li>';
    return;
  }
  try {
    const logs = await api('/api/signals/' + kontakId);
    if (!logs.length) {
      box.innerHTML = '<li style="color:var(--text-2);font-size:12px">Belum ada sinyal terkirim.</li>';
      return;
    }
    box.innerHTML = logs.map(l => {
      const icon = l.jenis === 'Purchase' ? '💰' : l.kualitas === 'hot' ? '🔥' : '🌤️';
      const label = l.jenis === 'Purchase'
        ? `Purchase${l.nilai_order ? ' Rp ' + Number(l.nilai_order).toLocaleString('id-ID') : ''}`
        : `Lead ${l.kualitas}`;
      const statusColor = l.status === 'terkirim' ? 'var(--green)' : 'var(--red)';
      return `<li style="font-size:12.5px;display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-bottom:1px dashed var(--soft-2)">
        <span>${icon}</span>
        <span style="flex:1">
          <strong>${label}</strong>
          <span style="color:${statusColor};margin-left:6px">${l.status === 'terkirim' ? '✓ Terkirim' : '✗ Gagal'}</span>
          <br><span style="color:var(--text-2);font-size:11px">${l.waktu}</span>
          ${l.pesan_error ? `<br><span style="color:var(--red);font-size:11px">${l.pesan_error}</span>` : ''}
        </span>
      </li>`;
    }).join('');
  } catch(e) {
    box.innerHTML = '<li style="color:var(--red);font-size:12px">Gagal load log.</li>';
  }
}

$("#filters").addEventListener("click",e=>{const c=e.target.closest(".chip");if(!c)return;[...document.querySelectorAll(".chip")].forEach(x=>x.classList.remove("active"));c.classList.add("active");state.filter=c.dataset.f;renderList()});
$("#q").addEventListener("input",e=>{state.q=e.target.value;renderList()});
$("#send-btn").addEventListener("click",send);
$("#reply-input").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();send()}});
document.addEventListener("click",e=>{if(e.target.closest("[data-soon]"))toast("Fitur ini aktif mulai Fase 1 / 2")});

loadChats();
setInterval(()=>{if(!state.demo){loadChats();if(state.active)loadMessages(state.active)}},5000);
</script>
</body>
