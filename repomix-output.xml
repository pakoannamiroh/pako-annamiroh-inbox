}

function renderList(){
  const list=$("#list");list.innerHTML="";
  const q=state.q.toLowerCase();
  const rows=state.chats.filter(c=>{
    if(state.filter!=="all"&&(c.status_lead||"")!==state.filter)return false;
    if(q&&!((c.nama||"").toLowerCase().includes(q)||(c.no_hp||"").includes(q)))return false;
    return true;
  });
  if(!rows.length){list.innerHTML='<div style="padding:24px;text-align:center" class="muted">Tidak ada kontak</div>';return}
  for(const c of rows){
    const lead=c.status_lead||"none";
    const el=document.createElement("div");
    el.className="chat-item"+(state.active===c.id?" active":"");
    el.onclick=()=>openChat(c.id);
    const aiBadge=c.ai_aktif===false?'<span class="badge b-ai off">AI Off</span>':'<span class="badge b-ai">AI On</span>';
    const unread=c.unread>0?`<span class="unread">${c.unread}</span>`:"";
